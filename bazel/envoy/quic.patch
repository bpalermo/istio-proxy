+  // Helper template for caching certificate extraction results.
+  template <typename T>
+  const T& getCachedCertificateValue(std::unique_ptr<T>* cache,
+                                     std::function<T()> extractor) const {
+    if (!*cache) {
+      *cache = std::make_unique<T>(extractor());
