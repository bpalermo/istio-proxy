# Envoy's own build options, copied from the pinned Envoy commit by
# scripts/update_envoy.sh. Do not edit envoy.bazelrc by hand.
import %workspace%/envoy.bazelrc

# The C++ toolchain is Envoy's hermetic LLVM; never probe the host for one.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

build --workspace_status_command=bazel/bazel_get_workspace_status

# ========================================
# Istio specific Bazel build/test options (from istio/proxy's .bazelrc).
# ========================================

# Enable path normalization by default.
# See: https://github.com/envoyproxy/envoy/pull/6519
build --define path_normalization_by_default=true

# Build with embedded V8-based WebAssembly runtime.
build --@proxy-wasm-cpp-host//bazel:engine=v8

# Build Proxy-WASM plugins as native extensions.
build --copt -DNULL_PLUGIN

build --cxxopt -Wformat
build --cxxopt -Wformat-security

# Release builds without debug symbols.
build:release -c opt
build:release --strip=always

# Release builds with debug symbols
build:release-symbol -c opt

# Debug builds
build:debug -c dbg

# ========================================
# Remote cache and execution (BuildBuddy)
# ========================================

build:remote-cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote-cache --bes_backend=grpcs://remote.buildbuddy.io
build:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
build:remote-cache --remote_cache_compression
build:remote-cache --nolegacy_important_outputs
build:remote-cache --experimental_remote_cache_compression_threshold=100

build:ci-remote-cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:ci-remote-cache --bes_backend=grpcs://remote.buildbuddy.io
build:ci-remote-cache --remote_cache=grpcs://remote.buildbuddy.io
build:ci-remote-cache --remote_download_toplevel # Helps remove network bottleneck if caching is enabled
build:ci-remote-cache --experimental_remote_cache_eviction_retries=5

build:rbe-buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --jobs=200
build:rbe-buildbuddy --nolegacy_important_outputs
build:rbe-buildbuddy --noslim_profile
build:rbe-buildbuddy --experimental_profile_include_target_label
build:rbe-buildbuddy --experimental_profile_include_primary_output

build:remote --remote_timeout=7200

build:ci --config=release
build:ci --config=ci-remote-cache
build:ci --build_metadata=VISIBILITY=PUBLIC
build:ci --build_metadata=ROLE=CI
# CI must build what the committed lockfile describes.
common:ci --lockfile_mode=error
common:ci --noshow_progress
common:ci --test_output=errors
